---
import {
  Footer_Menu_Query,
  Logo_Options_Query,
  Social_Media_Links_Query,
} from "../data/footer/queries";

import MainLogo from "../components/Logo/MainLogo.astro";
import FooterNav from "../components/Navigation/FooterNav/FooterNav.astro";
import SocialMediaLinks from "../components/SocialMedia/SocialMediaLinks.astro";
import Wrapper from "../components/shared/Wrapper.astro";

import "./footer.scss";

const response = await fetch(`${import.meta.env.PUBLIC_WP_URL}/graphql`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
        query headerQuery {
            ${Footer_Menu_Query}
            ${Logo_Options_Query}
            ${Social_Media_Links_Query}
        }
    `,
  }),
});
const {
  data: {
    menu: {
      menuItems: { nodes: menuItems },
    },
    mainLogo: { logoOptions },
    socialMediaLinks,
  },
} = await response.json();
---

<footer class="main-footer">
  <Wrapper wrapType="big" classes="main-footer__wrapper">
    <div class="main-footer__logo">
      <div class="main-footer__logo-wrapper">
        <a href="/" title="Startec. Click to return to home page."
          ><MainLogo data={logoOptions} /></a
        >
      </div>
    </div>
    <div class="main-footer__social-media">
      <SocialMediaLinks data={socialMediaLinks} />
    </div>
    <div class="main-footer__menu">
      <FooterNav items={menuItems} />
    </div>

    <div class="main-footer__copyright">
      <p>Copyright © 2024 Startec</p>
      <nav>
        <ul>
          <li><a href="/privacy-policy">Privacy Policy</a></li>
          <span> | </span>
          <li><a href="/terms-and-conditions/">Terms and Conditions</a></li>
        </ul>
      </nav>
    </div>
  </Wrapper>
</footer>
