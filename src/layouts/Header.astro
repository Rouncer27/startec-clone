---
import {
  Main_Menu_Query,
  Mobile_Menu_Query,
  Logo_Options_Query,
} from "../data/header/queries";
import { Social_Media_Links_Query } from "../data/footer/queries";
import MainNav from "../components/Navigation/MainNav/MainNav.jsx";
import MobileNav from "../components/Navigation/MobileNav/MobileNav";
import MainLogo from "../components/Logo/MainLogo.astro";
import Wrapper from "../components/shared/Wrapper.astro";
import SocialMediaLinks from "../components/SocialMedia/SocialMediaLinks.astro";

import "./header.scss";

const response = await fetch(`${import.meta.env.PUBLIC_WP_URL}/graphql`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
        query headerQuery {
          ${Main_Menu_Query}
          ${Mobile_Menu_Query}
          ${Logo_Options_Query}
          ${Social_Media_Links_Query}
        }
    `,
  }),
});
const {
  data: {
    menu: { menuItems },
    mobile: { menuItems: mobile },
    mainLogo: { logoOptions },
    socialMediaLinks,
  },
} = await response.json();
---

<header class="header">
  <Wrapper classes="header-wrapper">
    <div class="header-logo">
      <h1>
        <a href="/">
          <MainLogo data={logoOptions} />
        </a>
        <span>Startec</span>
      </h1>
    </div>
    <div class="header-navigation">
      <MainNav
        client:only="react"
        menuItems={menuItems.nodes}
        pathname={Astro.url.pathname}
      />
    </div>
    <div class="header-social">
      <SocialMediaLinks data={socialMediaLinks} />
    </div>
  </Wrapper>
  <div class="header-mobile">
    <MobileNav
      client:only="react"
      mainMenu={mobile}
      mainLogo={logoOptions}
      socialMedia={socialMediaLinks}
      pathname={Astro.url.pathname}
    />
  </div>
</header>
