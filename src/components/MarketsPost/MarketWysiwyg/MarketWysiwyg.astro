---
import Wrapper from "../../shared/Wrapper.astro";
import Wysiwyg from "../../shared/Wysiwyg.astro";
import "./marketWysiwyg.scss";
---

{
  Astro.props.data.activateThisComponent && (
    <div class="market-wysiwyg">
      <Wrapper>
        <Wysiwyg>
          <div
            class="market-wysiwyg-container"
            set:html={Astro.props.data.content}
          />
        </Wysiwyg>
      </Wrapper>
    </div>
  )
}
