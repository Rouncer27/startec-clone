---
import { Image } from "astro:assets";
import Wrapper from "../../shared/Wrapper.astro";
import "./imageDivider.scss";
---

{
  Astro.props.data.activateThisComponent && (
    <div class="image-divider">
      <Wrapper classes="image-divider__wrapper">
        <div class="image-divider__image">
          <Image
            src={Astro.props.data.image.node.sourceUrl}
            alt={Astro.props.data.image.node.altText}
            inferSize={true}
          />
        </div>
      </Wrapper>
    </div>
  )
}
