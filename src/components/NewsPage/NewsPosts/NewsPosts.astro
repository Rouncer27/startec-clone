---
import Wrapper from "../../shared/Wrapper.astro";
import "./newsPosts.scss";
---

<div>
  <Wrapper>
    {
      Astro.props.posts.map((post) => {
        return (
          <div>
            <div>
              <h2>{post.node.title}</h2>
            </div>
          </div>
        );
      })
    }
  </Wrapper>
</div>
