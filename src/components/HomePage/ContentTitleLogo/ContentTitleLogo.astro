---
import { Image } from "astro:assets";
import Wrapper from "../../shared/Wrapper.astro";
import Button from "../../shared/Button.astro";
import LetsConnectCard from "../../shared/LetsConnectCard.astro";
import Headline from "../../shared/Headline.astro";
import "./contentTitleLogo.scss";
---

<div class="content-title-logo">
  <Wrapper>
    <div class="content-title-logo-left">
      <div class="content-title-logo-left-title">
        <Headline ele="h2" hlstyle="two" set:html={Astro.props.data.title} />
      </div>
      <div class="content-title-logo-left-logo">
        <Image
          src={Astro.props.data.iconLogo.node.sourceUrl}
          alt={Astro.props.data.iconLogo.node.altText}
          inferSize={true}
        />
      </div>
    </div>
    <div class="content-title-logo-right">
      <div set:html={Astro.props.data.content} />
      <div>
        <Button
          btnstyle="two"
          href={Astro.props.data.buttonLink.edges[0].node.uri}
        >
          {Astro.props.data.buttonText}
        </Button>
      </div>
    </div>
  </Wrapper>
  {Astro.props.data.displayLetsConnectCard && <LetsConnectCard />}
</div>
