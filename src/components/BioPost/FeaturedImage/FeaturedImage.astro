---
import { Image } from "astro:assets";
import Wrapper from "../../shared/Wrapper.astro";
import "./featuredImage.scss";

import LinkedinLink from "../../SocialMedia/LinkedinLink.astro";
---

<div class="featured-image">
  <Wrapper classes="featured-image-wrapper" wrapType="stand">
    <div class="featured-image-container">
      <Image
        src={Astro.props.data.image.node.sourceUrl}
        alt={Astro.props.data.image.node.altText}
        inferSize={true}
      />
    </div>
    <div class="featured-image-content">
      <h1>{Astro.props.title}</h1>
      <p>{Astro.props.data.titleJob}</p>
      <!-- {
        Astro.props.data.subTitle ? (
          <p class="featured-image-content-sub-title">
            {Astro.props.data.subTitle}
          </p>
        ) : null
      } -->
      {
        Astro.props.data.linkedinReqiured && (
          <ul class="featured-image-content-linkedin">
            <LinkedinLink link={Astro.props.data.linkedin} />
          </ul>
        )
      }
    </div>
  </Wrapper>

  <div class="featured-image-bar"></div>
</div>
