---
import "./postNav.scss";
import Wrapper from "../../shared/Wrapper.astro";
---

<div class="news-post-nav">
  <Wrapper classes="news-post-nav-wrapper">
    {
      Astro.props.data.prev !== null ? (
        <div
          class={`news-post-nav-prev${Astro.props.data.next === null ? " news-post-nav-prev-alone" : ""}`}
        >
          <a href={`/news/${Astro.props.data.prev.slug}`}>
            <span>&lt;</span>Previous
          </a>
        </div>
      ) : null
    }
    {
      Astro.props.data.next !== null ? (
        <div
          class={`news-post-nav-next${Astro.props.data.prev === null ? " news-post-nav-next-alone" : ""}`}
        >
          <a href={`/news/${Astro.props.data.next.slug}`}>
            Next<span>&gt;</span>
          </a>
        </div>
      ) : null
    }
  </Wrapper>
</div>
