---
import { Image } from "astro:assets";
import Wrapper from "../../shared/Wrapper.astro";
import "./postHeader.scss";
---

<div class="news-post-header">
  <Wrapper>
    <div class="news-post-header-title">
      <p>
        {
          Astro.props.categories.map((cat) => {
            return <span>{cat.node.name} | </span>;
          })
        }
        <span>News</span>
      </p>
      <h1>{Astro.props.title}</h1>
    </div>
    <div class="news-post-header-image">
      <div class="news-post-header-image-inner">
        <Image
          src={Astro.props.featuredImage.sourceUrl}
          alt={Astro.props.featuredImage.altText}
          inferSize={true}
        />
      </div>
    </div>
  </Wrapper>
  <div class="news-post-header-bar"></div>
</div>
