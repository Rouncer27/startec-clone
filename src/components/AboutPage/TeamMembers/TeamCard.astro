---
import { Image } from "astro:assets";
import "./teamCard.scss";
---

<div class="team-card">
  <a href={`/about/${Astro.props.mem.slug}`}>
    <div class="team-card-image">
      <Image
        src={Astro.props.mem.biosPost.featuredImageComponent.image.node
          .sourceUrl}
        alt={Astro.props.mem.biosPost.featuredImageComponent.image.node.altText}
        inferSize={true}
      />
      <div class="team-card-image-button">
        <button type="button">Bio</button>
      </div>
    </div>
    <div class="team-card-title">
      <h3>{Astro.props.mem.title}</h3>
      <p>{Astro.props.mem.biosPost.featuredImageComponent.titleJob}</p>
      <!-- {
        Astro.props.mem.biosPost.featuredImageComponent.subTitle ? (
          <p class="team-card-title-sub-title">
            {Astro.props.mem.biosPost.featuredImageComponent.subTitle}
          </p>
        ) : null
      } -->
    </div>
  </a>
</div>
