---
import { Image } from "astro:assets";
import "./heroCallOut.scss";
import Headline from "../../shared/Headline.astro";
---

<div class="markets-call-out">
  <a href="/contact">
    <div class="markets-call-out-banner">
      <div class="markets-call-out-banner-icon">
        <div class="markets-call-out-banner-icon-wrapper">
          <Image
            src={Astro.props.data.iconImage.node.sourceUrl}
            alt={Astro.props.data.iconImage.node.altText}
            inferSize={true}
          />
        </div>
      </div>

      <div class="markets-call-out-banner-content">
        <div class="markets-call-out-banner-content-inner">
          <div>
            <Headline ele="h2" hlstyle="three"
              >{Astro.props.data.title}</Headline
            >
          </div>
          <div set:html={Astro.props.data.content} />
        </div>
      </div>
    </div>
  </a>

  <div class="markets-call-out-bgimage">
    <Image
      src={Astro.props.data.heroImage.node.sourceUrl}
      alt={Astro.props.data.heroImage.node.altText}
      inferSize={true}
    />
  </div>
</div>
