---
import "./footerNav.scss";
---

<div class="footer-nav">
  <ul class="footer-nav-items">
    {
      Astro.props.items.map((item) => {
        return (
          <li class="footer-nav-item">
            <a href={item.url}>{item.label}</a>
          </li>
        );
      })
    }
  </ul>
</div>
