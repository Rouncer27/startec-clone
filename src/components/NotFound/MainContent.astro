---
import Wrapper from "../shared/Wrapper.astro";
import "./mainContent.scss";
---

<div class="main-not-found-content">
  <Wrapper>
    <div class="main-not-found-content__title">
      <h1>404 Page Not Found</h1>
    </div>
    <div class="main-not-found-content__description">
