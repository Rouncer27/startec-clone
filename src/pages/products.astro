---
import Layout from "../layouts/Layout.astro";
import HeroImage from "../components/ProductPage/HeroImage/HeroImage.astro";
import ProductsCategories from "../components/ProductPage/ProductsCategories/ProductsCategories.jsx";
import SmallCallAction from "../components/ProductPage/SmallCallAction/SmallCallAction.astro";
import { getOptimizedImages } from "../utils/helperFunctions";

import { Page_Seo_Query } from "../data/Page/queries";
import {
  Hero_Image_Query,
  Small_Call_Action_Query,
  Products_Categories_Query,
} from "../data/products/queries";
import { getImage } from "astro:assets";

const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
			query homePageQuery {
				page(id: "/products", idType: URI) {
          ${Page_Seo_Query}
          productsPage {
          ${Hero_Image_Query}
          ${Small_Call_Action_Query}
          ${Products_Categories_Query}
          }
				}
			}
		`,
  }),
});

const {
  data: {
    page: { productsPage, seoMetaTags },
  },
} = await response.json();

const newOptimizedCategories = await Promise.all(
  productsPage.productsCategories.categories.map(async (cat) => {
    const featuredProductsOptimized = await Promise.all(
      cat.products.map(async (product) => {
        // const optImage = await getOptimizedImages(
        //   product.product.edges[0].node.productPost.productContentComponent
        //     .image.node.sourceUrl,
        //   false,
        // );

        const optImage = await getImage({
          src: product.product.edges[0].node.productPost.productContentComponent
            .image.node.sourceUrl,
          format: "webp",
          quality: 100,
          loading: "lazy",
          width: 1000,
          height: 1000,
        });

        const newProduct = {
          ...product,
          product: {
            edges: [
              {
                node: {
                  title: product.product.edges[0].node.title,
                  productPost: {
                    ...product.product.edges[0].node.productPost,
                    productContentComponent: {
                      ...product.product.edges[0].node.productPost
                        .productContentComponent,
                      image: {
                        node: {
                          sourceUrl: optImage.src,
                          options: optImage.attributes,
                          altText:
                            product.product.edges[0].node.productPost
                              .productContentComponent.image.node.altText,
                        },
                      },
                    },
                  },
                },
              },
            ],
          },
        };
        return newProduct;
      }),
    );

    const optimizedCategory = {
      ...cat,
      products: [...featuredProductsOptimized],
    };
    return optimizedCategory;
  }),
);
---

<Layout
  metaImg={seoMetaTags.seoMetaInformation.metaImage.sourceUrl}
  metaTitle={seoMetaTags.seoMetaInformation.metaTitle}
  metaDescription={seoMetaTags.seoMetaInformation.metaDescription}
>
  <HeroImage data={productsPage.heroImage} />
  <ProductsCategories client:only="react" data={newOptimizedCategories} />
  <SmallCallAction data={productsPage.smallCallAction} />
</Layout>
