---
import Layout from "../layouts/Layout.astro";
import HeroImage from "../components/ProductPage/HeroImage/HeroImage.astro";
import ProductsCategories from "../components/ProductPage/ProductsCategories/ProductsCategories.jsx";
import SmallCallAction from "../components/ProductPage/SmallCallAction/SmallCallAction.astro";

import { Page_Seo_Query } from "../data/Page/queries";
import {
  Hero_Image_Query,
  Small_Call_Action_Query,
  Products_Categories_Query,
} from "../data/products/queries";

const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
			query homePageQuery {
				page(id: "/products", idType: URI) {
          ${Page_Seo_Query}
          productsPage {
          ${Hero_Image_Query}
          ${Small_Call_Action_Query}
          ${Products_Categories_Query}
          }
				}
			}
		`,
  }),
});

const {
  data: {
    page: { productsPage, seoMetaTags },
  },
} = await response.json();
---

<Layout
  metaImg={seoMetaTags.seoMetaInformation.metaImage.sourceUrl}
  metaTitle={seoMetaTags.seoMetaInformation.metaTitle}
  metaDescription={seoMetaTags.seoMetaInformation.metaDescription}
>
  <HeroImage data={productsPage.heroImage} />
  <ProductsCategories
    client:only="react"
    data={productsPage.productsCategories}
  />
  <SmallCallAction data={productsPage.smallCallAction} />
</Layout>
