---
import Layout from "../layouts/Layout.astro";
import HeroImage from "../components/ContactPage/HeroImage/HeroImage.astro";
import ContactInformation from "../components/ContactPage/ContactInformation/ContactInformation.astro";

import { Page_Seo_Query } from "../data/Page/queries";
import {
  Hero_Image_Query,
  Contact_Information_Query,
  Contact_Map_Query,
} from "../data/contact/queries";

const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
			query homePageQuery {
				page(id: "/contact", idType: URI) {
          ${Page_Seo_Query}
          contactPage {
            ${Hero_Image_Query}
            ${Contact_Information_Query}
            ${Contact_Map_Query}
          }
				}
			}
		`,
  }),
});

const {
  data: {
    page: { contactPage, seoMetaTags },
  },
} = await response.json();
---

<Layout
  metaImg={seoMetaTags.seoMetaInformation.metaImage.sourceUrl}
  metaTitle={seoMetaTags.seoMetaInformation.metaTitle}
  metaDescription={seoMetaTags.seoMetaInformation.metaDescription}
>
  <HeroImage data={contactPage.heroImage} />
  <ContactInformation
    information={contactPage.contactInformation}
    map={contactPage.contactMap}
  />
</Layout>
