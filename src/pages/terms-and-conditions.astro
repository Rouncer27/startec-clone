---
import Layout from "../layouts/Layout.astro";
import MainContent from "../components/TermsConditions/MainContent/MainContent.astro";

import { Page_Seo_Query } from "../data/Page/queries";
import { Main_Content_Query } from "../data/termsConditions/queries";

const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
			query homePageQuery {
				page(id: "/terms-and-conditions", idType: URI) {
          ${Page_Seo_Query}
          termsConditionsPage {
            ${Main_Content_Query}
          }
				}
			}
		`,
  }),
});

const {
  data: {
    page: { seoMetaTags, termsConditionsPage },
  },
} = await response.json();
---

<Layout
  metaImg={seoMetaTags.seoMetaInformation.metaImage.node.sourceUrl}
  metaTitle={seoMetaTags.seoMetaInformation.metaTitle}
  metaDescription={seoMetaTags.seoMetaInformation.metaDescription}
>
  <MainContent data={termsConditionsPage.mainContent} />
</Layout>
