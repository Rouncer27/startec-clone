---
import Layout from "../layouts/Layout.astro";
import HeroSlider from "../components/HomePage/HeroSlider/HeroSlider";
import MarketsSlider from "../components/HomePage/MarketsSlider/MarketsSlider";
import ContentTitleLogo from "../components/HomePage/ContentTitleLogo/ContentTitleLogo.astro";
import ContentSideImageSide from "../components/HomePage/ContentSideImageSide/ContentSideImageSide.astro";
import ThreeImagesRow from "../components/HomePage/ThreeImagesRow/ThreeImagesRow.astro";
import HeroCallOut from "../components/HomePage/HeroCallOut/HeroCallOut.astro";
import "../styles/styles.scss";
import { optimizeSlider } from "../utils/helperFunctions";
import { getImage } from "astro:assets";

import {
  Hero_Slider_Query,
  Markets_Slider_Query,
  Content_Title_Logo_Query,
  Content_Side_Image_Side_Query,
  Three_Image_Row_Query,
  Hero_Call_Out_Query,
} from "../data/home/queries.js";

import { Page_Seo_Query } from "../data/Page/queries";

const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
			query homePageQuery {
				page(id: "/", idType: URI) {
          ${Page_Seo_Query}
          homePage {
            ${Hero_Slider_Query}
            ${Markets_Slider_Query}
            ${Content_Title_Logo_Query}
            ${Content_Side_Image_Side_Query}
            ${Three_Image_Row_Query}
            ${Hero_Call_Out_Query}
          }
				}
			}
		`,
  }),
});

const {
  data: {
    page: { seoMetaTags, homePage },
  },
} = await response.json();

// Main Hero Slider Image optimization //
const optimizedHeroSlider = await optimizeSlider(
  homePage.heroSlider.heroSliderSlides,
);

// Main Market Slider Image optimization //
const optimizedMarketSlider = await optimizeSlider(
  homePage.marketsSlider.marketsSliderSlides,
);

const optSeoImage = await getImage({
  src: seoMetaTags.seoMetaInformation.metaImage.node.sourceUrl,
  format: "webp",
  quality: 100,
  loading: "eager",
  inferSize: true,
});
---

<Layout
  metaImg={optSeoImage.src}
  metaTitle={seoMetaTags.seoMetaInformation.metaTitle}
  metaDescription={seoMetaTags.seoMetaInformation.metaDescription}
>
  <HeroSlider client:only="react" data={optimizedHeroSlider} />
  <MarketsSlider client:only="react" data={optimizedMarketSlider} />
  <ContentTitleLogo data={homePage.contentTitleLogo} />
  <ContentSideImageSide data={homePage.contentSideImageSide} />
  <ThreeImagesRow data={homePage.threeImagesRow} />
  <HeroCallOut data={homePage.heroCallOut} />
</Layout>
