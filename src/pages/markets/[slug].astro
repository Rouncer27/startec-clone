---
import Layout from "../../layouts/Layout.astro";
import HeroImage from "../../components/MarketsPost/HeroImage/HeroImage.astro";
import IntroTtitle from "../../components/MarketsPost/IntroTitle/IntroTtitle.astro";
import MarketWysiwyg from "../../components/MarketsPost/MarketWysiwyg/MarketWysiwyg.astro";
import ImageDivder from "../../components/MarketsPost/ImageDivider/ImageDivder.astro";
import FeaturedProducts from "../../components/MarketsPost/FeaturedProducts/FeaturedProducts.jsx";
import RelatedProjects from "../../components/MarketsPost/RelatedProjects/RelatedProjects.jsx";
import SmallCallAction from "../../components/MarketsPost/SmallCallAction/SmallCallAction.astro";
import { getOptimizedImages } from "../../utils/helperFunctions";

import { Page_Seo_Query } from "../../data/Page/queries";
import {
  Hero_Image_Query,
  Intro_Title_Query,
  Top_Content_Query,
  Image_Divider_Query,
  Bottom_Content_Query,
  Featured_Products_Query,
  Display_Related_Projects_Query,
  Small_Call_Action_Query,
} from "../../data/marketsPost/queries";

import {
  Related_Porjects_Query,
  Project_Excerpt_Query,
  Project_Featured_Image_Query,
} from "../../data/projects/queries";

export async function getStaticPaths() {
  const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
    method: "POST",
    headers: {
      "content-type": "application/json",
    },
    body: JSON.stringify({
      query: `
        query marketsQuery {
            markets(first: 999999) {
                nodes {
                    slug
                    uri
                    title
                }
            }
        }
      `,
    }),
  });

  const { data } = await response.json();
  return data.markets.nodes.map((mark, index) => {
    return {
      params: { slug: `${mark.slug}` },
      props: {
        next: index === 0 ? null : data.markets.nodes[index - 1],
        prev:
          index === data.markets.nodes.length - 1
            ? null
            : data.markets.nodes[index + 1],
      },
    };
  });
}

const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
    query marketsPostQuery($id: ID!) {
      market(idType: SLUG, id: $id) {
          ${Page_Seo_Query}
          marketsPost {
              ${Hero_Image_Query}
              ${Intro_Title_Query}
              ${Top_Content_Query}
              ${Image_Divider_Query}
              ${Bottom_Content_Query}
              ${Featured_Products_Query}
              ${Display_Related_Projects_Query}
              ${Small_Call_Action_Query}
          }
      }

      allProjects: project(first: 999999) {
        edges {
          node {
            title
            slug
            uri
            projectPost {
              ${Related_Porjects_Query}
              ${Project_Featured_Image_Query}
              ${Project_Excerpt_Query}
            }
          }
        }
      }
    }
    `,
    variables: {
      id: Astro.params["slug"],
    },
  }),
});

const {
  data: {
    market: { seoMetaTags, marketsPost },
    allProjects,
  },
} = await response.json();

// Featured Products Image optimization //

const featuredProductsOptimized = await Promise.all(
  marketsPost.featuredProducts.products.map(async (product) => {
    const optImage = await getOptimizedImages(
      product.product.edges[0].node.productPost.productContentComponent.image
        .node.sourceUrl,
      false,
    );
    const newProduct = {
      ...product,
      product: {
        edges: [
          {
            node: {
              title: product.product.edges[0].node.title,
              productPost: {
                ...product.product.edges[0].node.productPost,
                productContentComponent: {
                  ...product.product.edges[0].node.productPost
                    .productContentComponent,
                  image: {
                    node: {
                      sourceUrl: optImage.src,
                      options: optImage.attributes,
                      altText:
                        product.product.edges[0].node.productPost
                          .productContentComponent.image.node.altText,
                    },
                  },
                },
              },
            },
          },
        ],
      },
    };

    return newProduct;
  }),
);

const newFeaturedProducts = {
  title: marketsPost.featuredProducts.title,
  products: [...featuredProductsOptimized],
};

// Main Related Project Slider Image optimization //
const relatedProjects = allProjects.edges.filter((project) => {
  const projectRelatedMarkets =
    project?.node?.projectPost?.marketsRelated?.marketsRelated?.edges;

  const isMatched = projectRelatedMarkets?.find((market) => {
    return market?.node?.slug === Astro.params["slug"];
  });
  return isMatched;
});

const optimizedRelatedProjects = await Promise.all(
  relatedProjects.map(async (project) => {
    const optImage = await getOptimizedImages(
      project.node.projectPost.featuredImage.image.node.sourceUrl,
      false,
    );
    const newProject = {
      node: {
        ...project.node,
        projectPost: {
          ...project.node.projectPost,
          featuredImage: {
            image: {
              node: {
                sourceUrl: optImage.src,
                options: optImage.attributes,
                altText:
                  project.node.projectPost.featuredImage.image.node.altText,
              },
            },
          },
        },
      },
    };

    return newProject;
  }),
);
---

<Layout
  metaImg={seoMetaTags.seoMetaInformation.metaImage.sourceUrl}
  metaTitle={seoMetaTags.seoMetaInformation.metaTitle}
  metaDescription={seoMetaTags.seoMetaInformation.metaDescription}
>
  <HeroImage data={marketsPost.heroImage} />
  <IntroTtitle data={marketsPost.introTitle} />
  <MarketWysiwyg data={marketsPost.topContent} />
  <ImageDivder data={marketsPost.imageDivider} />
  <MarketWysiwyg data={marketsPost.bottomContent} />
  <FeaturedProducts client:only="react" data={newFeaturedProducts} />
  <RelatedProjects
    client:only="react"
    projects={optimizedRelatedProjects}
    data={marketsPost.displayRelatedProjects}
  />
  <SmallCallAction data={marketsPost.smallCallAction} />
</Layout>
