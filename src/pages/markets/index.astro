---
import Layout from "../../layouts/Layout.astro";
import HeroImage from "../../components/MarketsPage/HeroImage/HeroImage.astro";
import SimpleIntro from "../../components/MarketsPage/SimpleIntro/SimpleIntro.astro";
import MarketsSlider from "../../components/HomePage/MarketsSlider/MarketsSlider";
import ContentTitleLogo from "../../components/MarketsPage/ContentTitleLogo/ContentTitleLogo.astro";
import HeroCallOut from "../../components/HomePage/HeroCallOut/HeroCallOut.astro";

import { Page_Seo_Query } from "../../data/Page/queries";
import {
  Hero_Image_Query,
  Simple_Intro_Query,
  Markets_Slider_Query,
  Content_Title_Logo_Query,
  Hero_Call_Out_Query,
} from "../../data/markets/queries";

const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
			query markestPageQuery {
				page(id: "/markets", idType: URI) {
          ${Page_Seo_Query}
          marketsWeServePage {
            ${Hero_Image_Query}
            ${Simple_Intro_Query}
            ${Markets_Slider_Query}
            ${Content_Title_Logo_Query}
            ${Hero_Call_Out_Query}
          }
				}
			}
		`,
  }),
});

const {
  data: {
    page: { marketsWeServePage, seoMetaTags },
  },
} = await response.json();
---

<Layout
  metaImg={seoMetaTags.seoMetaInformation.metaImage.sourceUrl}
  metaTitle={seoMetaTags.seoMetaInformation.metaTitle}
  metaDescription={seoMetaTags.seoMetaInformation.metaDescription}
>
  <HeroImage data={marketsWeServePage.heroImage} />
  <SimpleIntro data={marketsWeServePage.simpleIntro} />
  <MarketsSlider client:only="react" data={marketsWeServePage.marketsSlider} />
  <ContentTitleLogo data={marketsWeServePage.contentTitleLogo} />
  <HeroCallOut data={marketsWeServePage.heroCallOut} />
</Layout>
