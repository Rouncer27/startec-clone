---
import Layout from "../../layouts/Layout.astro";
import PostHeader from "../../components/NewsPost/PostHeader/PostHeader.astro";
import PostContent from "../../components/NewsPost/PostContent/PostContent.astro";
import PostGallery from "../../components/NewsPost/PostGallery/PostGallery.astro";
import PostNav from "../../components/NewsPost/PostNav/PostNav.astro";

import { Page_Seo_Query } from "../../data/Page/queries";
import {
  Post_Content_Query,
  Post_Featured_Image_Query,
  Post_Gallery_Images_Query,
  Post_Categories_Query,
} from "../../data/newsPost/queries";

export async function getStaticPaths() {
  const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
    method: "POST",
    headers: {
      "content-type": "application/json",
    },
    body: JSON.stringify({
      query: `
        query postQuery {
            posts(first: 999999) {
                nodes {
                    slug
                    uri
                }
            }
        }
      `,
    }),
  });

  const { data } = await response.json();
  const allPosts = data.posts.nodes;
  return allPosts.map((post, index) => {
    return {
      params: { slug: `${post.slug}` },
      props: {
        next:
          index === 0
            ? null
            : {
                slug: allPosts[index - 1].slug,
                title: allPosts[index - 1].title,
              },
        prev:
          index === allPosts.length - 1
            ? null
            : {
                slug: allPosts[index + 1].slug,
                title: allPosts[index + 1].title,
              },
      },
    };
  });
}

const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
    query postQuery($id: ID!) {
        post(idType: SLUG, id: $id) {
          ${Page_Seo_Query}
          ${Post_Categories_Query}
          title
          slug
          newsPosts {
            ${Post_Featured_Image_Query}
            ${Post_Content_Query}
            ${Post_Gallery_Images_Query}
          }
        }
    }
    `,
    variables: {
      id: Astro.params["slug"],
    },
  }),
});

const {
  data: { post },
} = await response.json();
---

<Layout
  metaImg={post?.seoMetaTags?.seoMetaInformation?.metaImage?.node?.sourceUrl}
  metaTitle={post?.seoMetaTags?.seoMetaInformation?.metaTitle}
  metaDescription={post?.seoMetaTags?.seoMetaInformation?.metaDescription}
>
  <PostHeader
    title={post.title}
    categories={post.categories.edges}
    featuredImage={post.newsPosts.featuredImage.node}
  />
  <PostContent data={post.newsPosts.mainContent} />
  <PostGallery data={post.newsPosts} />
  <PostNav data={Astro.props} />
</Layout>
