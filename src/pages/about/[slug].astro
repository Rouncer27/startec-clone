---
import Layout from "../../layouts/Layout.astro";
import FeaturedImage from "../../components/BioPost/FeaturedImage/FeaturedImage.astro";
import MainBio from "../../components/BioPost/MainBio/MainBio.astro";
import BioNav from "../../components/BioPost/BioNav/BioNav.astro";

import { Page_Seo_Query } from "../../data/Page/queries";
import { Featured_Image_Query, Main_Bio_Query } from "../../data/bio/queries";

export async function getStaticPaths() {
  const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
    method: "POST",
    headers: {
      "content-type": "application/json",
    },
    body: JSON.stringify({
      query: `
        query biosQuery {
            bios(first: 999999) {
                nodes {
                    uri
                    slug
                    title
                }   
            }
        }
        `,
    }),
  });

  const { data } = await response.json();
  return data.bios.nodes.map((bio, index) => {
    return {
      params: { slug: `${bio.slug}` },
      props: {
        next: index === 0 ? null : data.bios.nodes[index - 1],
        prev:
          index === data.bios.nodes.length - 1
            ? null
            : data.bios.nodes[index + 1],
      },
    };
  });
}

const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
    query bioQuery($id: ID!) {
        bio(idType: SLUG, id: $id) {
          ${Page_Seo_Query}
          title
          biosPost {
            ${Featured_Image_Query}
            ${Main_Bio_Query}
          }
        }
    }
    `,
    variables: {
      id: Astro.params["slug"],
    },
  }),
});

const {
  data: {
    bio,
    bio: { biosPost, seoMetaTags },
  },
} = await response.json();
---

<Layout
  metaImg={seoMetaTags.seoMetaInformation.metaImage.sourceUrl}
  metaTitle={seoMetaTags.seoMetaInformation.metaTitle}
  metaDescription={seoMetaTags.seoMetaInformation.metaDescription}
>
  <FeaturedImage data={biosPost.featuredImage} title={bio.title} />
  <MainBio data={biosPost.mainBio} />
  <BioNav data={Astro.props} />
</Layout>
