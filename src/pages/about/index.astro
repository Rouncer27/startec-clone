---
import Layout from "../../layouts/Layout.astro";
import HeroImage from "../../components/AboutPage/HeroImage/HeroImage.astro";
import Intro from "../../components/AboutPage/Intro/Intro.astro";
import OurValues from "../../components/AboutPage/OurValues/OurValues.jsx";
import TeamMembers from "../../components/AboutPage/TeamMembers/TeamMembers.astro";
import TeamVideo from "../../components/AboutPage/TeamVideo/TeamVideo.astro";
import SmallCallAction from "../../components/AboutPage/SmallCallAction/SmallCallAction.astro";

import { Page_Seo_Query } from "../../data/Page/queries";
import {
  Hero_Image_Query,
  Intro_Query,
  Our_Values_Query,
  Executive_Team_Query,
  Leadership_Team_Query,
  Team_Video_Query,
  Small_Call_Action_Query,
} from "../../data/about/queries";

const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
			query homePageQuery {
				page(id: "/about", idType: URI) {
          ${Page_Seo_Query}
          aboutPage {
            ${Hero_Image_Query}
            ${Intro_Query}
            ${Our_Values_Query}
            ${Executive_Team_Query}
            ${Leadership_Team_Query}
            ${Team_Video_Query}
            ${Small_Call_Action_Query}
          }
				}
			}
		`,
  }),
});

const {
  data: {
    page: { aboutPage, seoMetaTags },
  },
} = await response.json();

// console.log("aboutPage", aboutPage);
---

<Layout
  metaImg={seoMetaTags.seoMetaInformation.metaImage.sourceUrl}
  metaTitle={seoMetaTags.seoMetaInformation.metaTitle}
  metaDescription={seoMetaTags.seoMetaInformation.metaDescription}
>
  <HeroImage data={aboutPage.heroImage} />
  <Intro data={aboutPage.intro} />
  <OurValues client:only="react" data={aboutPage.ourValues} />
  <TeamMembers title="Executive Team" data={aboutPage.executiveTeam} />
  <TeamMembers title="Leadership Team" data={aboutPage.leadershipTeam} />
  <TeamVideo data={aboutPage.teamVideo} />
  <SmallCallAction data={aboutPage.smallCallAction} />
</Layout>
