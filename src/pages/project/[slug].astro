---
import Layout from "../../layouts/Layout.astro";

import { Page_Seo_Query } from "../../data/Page/queries";

export async function getStaticPaths() {
  const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
    method: "POST",
    headers: {
      "content-type": "application/json",
    },
    body: JSON.stringify({
      query: `
        query projectsQuery {
            project(first: 999999) {
                nodes {
                    slug
                    uri
                    title
                }
            }
        }
      `,
    }),
  });

  const { data } = await response.json();
  return data.project.nodes.map((mark, index) => {
    return {
      params: { slug: `${mark.slug}` },
      props: {
        next: index === 0 ? null : data.project.nodes[index - 1],
        prev:
          index === data.project.nodes.length - 1
            ? null
            : data.project.nodes[index + 1],
      },
    };
  });
}

const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
    query projectsPostQuery($id: ID!) {
      projects(idType: SLUG, id: $id) {
        ${Page_Seo_Query}
      }
    }
    `,
    variables: {
      id: Astro.params["slug"],
    },
  }),
});

const {
  data: {
    projects: { seoMetaTags },
  },
} = await response.json();

console.log(Astro.params);
---

<Layout
  metaImg={seoMetaTags.seoMetaInformation.metaImage.sourceUrl}
  metaTitle={seoMetaTags.seoMetaInformation.metaTitle}
  metaDescription={seoMetaTags.seoMetaInformation.metaDescription}
>
  <h1>Single Project</h1>
</Layout>
