---
import Layout from "../../layouts/Layout.astro";
import ProjectHeader from "../../components/ProjectPost/ProjectHeader/ProjectHeader.astro";
import ProjectContent from "../../components/ProjectPost/ProjectContent/ProjectContent.astro";
import RelatedProjects from "../../components/ProjectPost/RelatedProjects/RelatedProjects.jsx";
import ProjectGallery from "../../components/ProjectPost/ProjectGallery/ProjectGallery.astro";

import { Page_Seo_Query } from "../../data/Page/queries";
import {
  Project_Content_Query,
  Project_Excerpt_Query,
  Project_Featured_Image_Query,
  Project_Gallery_Images_Query,
  Related_Porjects_Query,
} from "../../data/projects/queries";

export async function getStaticPaths() {
  const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
    method: "POST",
    headers: {
      "content-type": "application/json",
    },
    body: JSON.stringify({
      query: `
        query projectsQuery {
            project(first: 999999) {
                nodes {
                    slug
                    uri
                    title
                }
            }
        }
      `,
    }),
  });

  const { data } = await response.json();
  return data.project.nodes.map((pro, index) => {
    return {
      params: { slug: `${pro.slug}` },
      props: {
        next: index === 0 ? null : data.project.nodes[index - 1],
        prev:
          index === data.project.nodes.length - 1
            ? null
            : data.project.nodes[index + 1],
      },
    };
  });
}

const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
    query projectsPostQuery($id: ID!) {
        allProjects: project(first: 999999) {
            edges {
                node {
                    title
                    slug
                    uri
                    projectPost {
                        ${Related_Porjects_Query}
                        ${Project_Featured_Image_Query}
                        ${Project_Excerpt_Query}
                    }
                }
            }
      }

      projects(idType: SLUG, id: $id) {
        ${Page_Seo_Query}
        title
        projectPost {
            ${Related_Porjects_Query}
            ${Project_Content_Query}
            ${Project_Featured_Image_Query}
            ${Project_Gallery_Images_Query}
        }
      }
    }
    `,
    variables: {
      id: Astro.params["slug"],
    },
  }),
});

const {
  data: { projects, allProjects },
} = await response.json();
---

<Layout
  metaImg={projects.seoMetaTags.seoMetaInformation.metaImage.sourceUrl}
  metaTitle={projects.seoMetaTags.seoMetaInformation.metaTitle}
  metaDescription={projects.seoMetaTags.seoMetaInformation.metaDescription}
>
  <ProjectHeader
    title={projects.title}
    relatedProjects={projects.projectPost.marketsRelated.marketsRelated.edges}
    featuredImage={projects.projectPost.featuredImage.image.node}
  />
  <ProjectContent data={projects.projectPost.mainContent} />
  <ProjectGallery data={projects.projectPost.galleryImages} />
  <RelatedProjects
    client:only="react"
    relatedMarkets={projects.projectPost.marketsRelated.marketsRelated.edges}
    projects={allProjects.edges}
  />
</Layout>
