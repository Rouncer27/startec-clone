---
import Layout from "../layouts/Layout.astro";
import HeroImage from "../components/CareersPage/HeroImage/HeroImage.astro";
import Intro from "../components/CareersPage/Intro/Intro.astro";

import { Page_Seo_Query } from "../data/Page/queries";

import {
  Hero_Image_Query,
  Intro_Query,
  Careers_Embed_Query,
} from "../data/careers/queries";
import Wrapper from "../components/shared/Wrapper.astro";
import CareersEmbed from "../components/CareersPage/CareersEmbed/CareersEmbed.astro";

const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
			query homePageQuery {
				page(id: "/careers", idType: URI) {
          ${Page_Seo_Query}
          careersPage {
            ${Hero_Image_Query}
            ${Intro_Query}
            ${Careers_Embed_Query}
          }
				}
			}
		`,
  }),
});

const {
  data: {
    page: { careersPage, seoMetaTags },
  },
} = await response.json();
---

<Layout
  metaImg={seoMetaTags.seoMetaInformation.metaImage.node.sourceUrl}
  metaTitle={seoMetaTags.seoMetaInformation.metaTitle}
  metaDescription={seoMetaTags.seoMetaInformation.metaDescription}
>
  <HeroImage data={careersPage.heroImage} />
  <Intro data={careersPage.intro} />
  <CareersEmbed data={careersPage.careersEmbed} />
</Layout>
